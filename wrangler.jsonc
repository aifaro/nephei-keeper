{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nephei-keeper",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "observability": { "enabled": true },
  "workers_dev": false,
  "routes": [ { "pattern": "keeper.nephei.org", "custom_domain": true } ]
}
